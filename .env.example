# Telegram bot config
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
ALLOWED_USER_IDS=123456789,987654321
# Fail-closed by default. Only set true if intentionally exposing every command publicly.
ALLOW_PUBLIC_BOT=false

# 9router (OpenAI-compatible) — set your real key in .env (never commit it)
ROUTER_BASE=https://9router.kliksosmed.id/v1
ROUTER_KEY=sk-REPLACE_WITH_YOUR_KEY
MODEL_DETECT=al/qwen3.7-flash
MODEL_REPORT=al/deepseek-v4-flash

# misc
HTTP_TIMEOUT=20
USER_AGENT=vuln-agent/1.0 (+security-research)
LLM_TIMEOUT=180
LLM_MAX_STEPS=12
